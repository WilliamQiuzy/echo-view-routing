# echo-view-routing — project-local environment (NEVER commit; .gitignore covers it)
# Prefix ECHO_ keeps these separate from the co-tenant QWEN_TRAIN_* project on the same server.

ECHO_PROJECT_NAME=echo-view-routing

# --- Remote compute (Nebius) ---
ECHO_TRAIN_PROVIDER=nebius
ECHO_SSH_HOST=<server-ip>
ECHO_SSH_PORT=22
ECHO_SSH_USER=<user>
# Dedicated SSH alias for this project (same machine as qwen-agent-l40s; defined in ~/.ssh/config)
ECHO_SSH_ALIAS=echo-l40s
ECHO_SSH_IDENTITY=~/.ssh/<key>

ECHO_GPU_MODEL=L40S
ECHO_VCPUS=8
ECHO_RAM_GIB=32
ECHO_BOOT_DISK_GIB=1280
ECHO_REGION=eu-north1
ECHO_PREEMPTIBLE=true

# --- Policy ---
ECHO_SERVER_ONLY=true              # all training/inference/data on the server
ECHO_LOCAL_FALLBACK=false          # never fall back to Mac CPU for training
ECHO_DATA_UPLOAD_AUTHORIZED=true   # public CC-BY-4.0 data may be placed on the server
ECHO_GPU_MEM_FRACTION=0.6          # leave headroom for the co-tenant job on the shared L40S

# --- Remote layout (isolated from /home/<user>/qwen-agent-training) ---
ECHO_REMOTE_ROOT=/home/<user>/echo-view-routing
ECHO_REMOTE_PYTHON=/home/<user>/echo-view-routing/.venv/bin/python
ECHO_REMOTE_DATA_ROOT=/home/<user>/echo-view-routing/data
ECHO_REMOTE_RUNS_ROOT=/home/<user>/echo-view-routing/runs
ECHO_REMOTE_CHECKPOINTS_ROOT=/home/<user>/echo-view-routing/checkpoints
ECHO_REMOTE_LOGS_ROOT=/home/<user>/echo-view-routing/logs
ECHO_CO_TENANT_ROOT=/home/<user>/qwen-agent-training   # informational only; never written to

# --- Local layout (Mac: code + a few demo samples only) ---
ECHO_LOCAL_ROOT=/path/to/echo-view-routing
ECHO_LOCAL_DEMO_SAMPLES=demo/samples

# --- Data ---
ECHO_HF_DATASET=bgx666/EV9V
ECHO_HF_DATASET_REVISION=094135b4da40c9aed9d9550c65305dc8715c7d3a
HF_TOKEN=
