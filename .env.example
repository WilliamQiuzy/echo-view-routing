# echo-view-routing — project-local environment (NEVER commit; .gitignore covers it)

ECHO_PROJECT_NAME=echo-view-routing


# --- Policy ---
ECHO_SERVER_ONLY=true              # all training/inference/data on the server
ECHO_LOCAL_FALLBACK=false          # never fall back to Mac CPU for training
ECHO_DATA_UPLOAD_AUTHORIZED=true   # public CC-BY-4.0 data may be placed on the server
ECHO_GPU_MEM_FRACTION=0.6          # leave headroom when the GPU is shared


# --- Local layout (Mac: code + a few demo samples only) ---
ECHO_LOCAL_ROOT=/path/to/echo-view-routing
ECHO_LOCAL_DEMO_SAMPLES=demo/samples

# --- Data ---
ECHO_HF_DATASET=bgx666/EV9V
ECHO_HF_DATASET_REVISION=094135b4da40c9aed9d9550c65305dc8715c7d3a
HF_TOKEN=

# --- Redivis (Stanford AIMI EchoNet) ---
REDIVIS_API_TOKEN=
