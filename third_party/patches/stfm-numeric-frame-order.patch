+def _frame_key(name):
+    """EV9V frames are 0.jpg, 1.jpg, ... without zero padding: order by the number, not the text."""
+    nums = _re.findall(r"\d+", name.rsplit(".", 1)[0])
+    return (0, int(nums[-1]), name) if nums else (1, 0, name)
